@startuml AD-TenantRentalProcess
title Tenant Rental Process

start
:Visit SmartRent platform;
if (Logged in?) then (no)
  :Register / Login;
endif
:Browse / Search properties;
:View property details;
if (Like the property?) then (yes)
  :Add to Favorites (optional);
  :Request a Visit;
  :Wait for landlord response;
  if (Visit accepted?) then (yes)
    :Visit property;
    if (Want to apply?) then (yes)
      :Submit Rental Application;
      :Upload required documents;
      :Wait for landlord decision;
      if (Application accepted?) then (yes)
        :Rental record created;
        :Receive welcome notification;
        :Complete rental period;
        :Leave a Review;
      else (rejected)
        :Receive rejection notification;
      endif
    else (no)
      :Look for other properties;
    endif
  else (rejected)
    :Receive rejection notification;
  endif
else (no)
  :Continue browsing;
endif
stop

@enduml

@startuml AD-LandlordFlow
title Landlord Property & Application Management

start
:Register as Landlord;
:Wait for Admin approval;
if (Approved?) then (yes)
  :Receive approval notification;
  :Create Property listing;
  :Add images, amenities, description;
  :Submit for admin review;
  if (Property approved?) then (yes)
    :Property visible to tenants;
    fork
      :Receive Visit Requests;
      :Review visit details;
      if (Accept visit?) then (yes)
        :Confirm visit;
      else (no)
        :Reject visit;
      endif
    fork again
      :Receive Rental Applications;
      :Review application + documents;
      if (Accept application?) then (yes)
        :Rental created automatically;
        :Property marked as Rented;
        :Receive rental notification;
      else (no)
        :Reject application;
        :Tenant notified;
      endif
    end fork
  else (rejected)
    :Property hidden;
    :Receive rejection notification;
  endif
else (rejected)
  :Account deactivated;
  :Receive rejection notification;
endif
stop

@enduml

@startuml AD-AdminApprovalProcess
title Admin Approval Process

start
:Login as Admin;
:Access Admin Dashboard;
fork
  :Review Pending Landlords;
  repeat
    :View landlord profile + ID;
    if (Approve?) then (yes)
      :Set isApproved = true;
      :Publish LandlordApproved event;
      :Landlord notified;
    else (no)
      :Set isApproved = false, isActive = false;
      :Publish LandlordRejected event;
      :Landlord notified;
    endif
  repeat while (More pending landlords?) is (yes)
fork again
  :Review Pending Properties;
  repeat
    :View property details;
    if (Approve?) then (yes)
      :Set isApproved = true;
      :Set approvedByAdminID;
      :Publish PropertyApproved event;
      :Landlord notified;
    else (no)
      :Set isActive = false;
      :Publish PropertyRejected event;
      :Landlord notified;
    endif
  repeat while (More pending properties?) is (yes)
fork again
  :Manage Users;
  :Activate or Deactivate user accounts;
end fork
stop

@enduml
