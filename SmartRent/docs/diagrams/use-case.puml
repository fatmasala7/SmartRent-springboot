@startuml SmartRent-UseCases
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Tenant"   as T
actor "Landlord" as L
actor "Admin"    as A
actor "Public"   as P

rectangle "SmartRent System" {

  package "Auth Module" {
    usecase "Register"                as UC_REG
    usecase "Login"                   as UC_LOGIN
    usecase "View/Update Profile"     as UC_PROFILE
    usecase "Approve Landlord"        as UC_APPROVE_L
    usecase "Reject Landlord"         as UC_REJECT_L
    usecase "Activate/Deactivate User" as UC_TOGGLE
  }

  package "Property Module" {
    usecase "Browse Properties"       as UC_BROWSE
    usecase "Search Properties"       as UC_SEARCH
    usecase "Create Property"         as UC_CREATE_P
    usecase "Edit/Delete Property"    as UC_EDIT_P
    usecase "Add Images & Amenities"  as UC_IMAGES
    usecase "Approve Property"        as UC_APPROVE_P
    usecase "Reject Property"         as UC_REJECT_P
  }

  package "Booking Module" {
    usecase "Request Visit"           as UC_VISIT
    usecase "Manage Visit Requests"   as UC_MANAGE_V
    usecase "Submit Application"      as UC_APP
    usecase "Upload Documents"        as UC_DOCS
    usecase "Accept/Reject Application" as UC_MANAGE_A
    usecase "View Rentals"            as UC_RENTALS
  }

  package "Engagement Module" {
    usecase "Add to Favorites"        as UC_FAV
    usecase "Write Review"            as UC_REVIEW
    usecase "View Notifications"      as UC_NOTIF
  }
}

' Public
P --> UC_BROWSE
P --> UC_SEARCH

' Tenant
T --> UC_REG
T --> UC_LOGIN
T --> UC_PROFILE
T --> UC_BROWSE
T --> UC_SEARCH
T --> UC_VISIT
T --> UC_APP
T --> UC_DOCS
T --> UC_RENTALS
T --> UC_FAV
T --> UC_REVIEW
T --> UC_NOTIF

' Landlord
L --> UC_REG
L --> UC_LOGIN
L --> UC_PROFILE
L --> UC_CREATE_P
L --> UC_EDIT_P
L --> UC_IMAGES
L --> UC_MANAGE_V
L --> UC_MANAGE_A
L --> UC_RENTALS
L --> UC_NOTIF

' Admin
A --> UC_LOGIN
A --> UC_APPROVE_L
A --> UC_REJECT_L
A --> UC_TOGGLE
A --> UC_APPROVE_P
A --> UC_REJECT_P
A --> UC_NOTIF

@enduml
